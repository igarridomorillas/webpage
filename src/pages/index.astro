    <style is:inline>
      .toast {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        width: fit-content;
        height: fit-content;
        padding-block: 0.25rem;
        padding-inline: 0.75rem;
        color: white;
        background-color: #214c62;
        border: solid 4px #214c62;
        border-radius: 4px;

        transition: bottom 0.4s ease-out;
      }
      .toast.hidden {
        /* display: none; */
        bottom: -5rem;
        transition: bottom 1s ease-in;
      }
    </style>
    <div class="js_toast toast hidden">Copiado!</div>
    <script type="text/javascript" is:inline>
      const contactByEmailLink = Array.from(
        document.querySelectorAll('a[href="#"]'),
      ).find((a) => (a.textContent = "Email"));
      const cNumber = 11 * 10 - 10 / 10;
      const toastElement = document.querySelector(".js_toast");

      contactByEmailLink.addEventListener("click", (ev) => {
        ev.preventDefault();
        navigator.clipboard.writeText(
          String.fromCharCode(cNumber) +
            String.fromCharCode(cNumber - Math.pow(2, 3)) +
            String.fromCharCode(Math.pow(2, 6)) +
            window.location.hostname,
        );
        toastElement.textContent = "Email copiado al portapapeles";
        toastElement.classList.remove("hidden");
        setTimeout(() => {
          toastElement.classList.add("hidden");
        }, 1500);
      });
    </script>
